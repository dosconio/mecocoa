# ASCII Makefile TAB4 LF
# Attribute: Shell(Bash)
# ModuTitle: Build subapps for Mecocoa x86 (LLVM/Clang version)

BIN_DIR = $(uobjpath)/sapp-$(arch)
LIBNATIVE = $(uobjpath)/$(ACCM_LIBS)/libx86.a
MCCA_TRIPLE ?= i686-mcca
MCCA_SYSROOT ?= accmlib/sysroot
MCCA_CC ?= clang -target i686-unknown-none-elf
MCCA_CXX ?= clang++ -target i686-unknown-none-elf
MCCA_CRT0 = $(MCCA_SYSROOT)/usr/lib/$(MCCA_TRIPLE)/crt0.o
MCCA_LIBC = $(MCCA_SYSROOT)/usr/lib/$(MCCA_TRIPLE)/libc.a
MCCA_COMFLAGS = -D_ACCM=0x8632 -D_ARC_x86=5 -D_DEBUG  -I$(uincpath) -I$(uincpath)/c/ISO_IEC_STD -I$(uincpath)/c/API-POSIX -I$(MCCA_SYSROOT)/usr/include

MCCA_CFLAGS = $(MCCA_COMFLAGS) --sysroot=$(MCCA_SYSROOT) -m32 -fno-builtin -fno-stack-protector -fno-pic -fno-pie -static -nostdlib \
	-Wno-incompatible-library-redeclaration -Wno-invalid-constexpr -Wno-empty-body -Wno-unknown-warning-option
MCCA_CXXFLAGS = $(MCCA_CFLAGS) -fno-exceptions -fno-rtti -fno-use-cxa-atexit -std=c++2a
MCCA_LDLIBS = $(MCCA_CRT0) $(MCCA_LIBC) -lgcc -Wl,-m,elf_i386 -Wl,-z,noexecstack -no-pie -fuse-ld=lld
STDCPP_APP_CXXFLAGS = -m32 -static -nodefaultlibs -nostartfiles -fno-omit-frame-pointer -fno-stack-protector -fno-pic -fno-builtin -fno-strict-aliasing -ffunction-sections -fdata-sections $(CXW) -std=c++2a
STDCPP_APP_LIBS = -L$(uobjpath)/$(ACCM_LIBS) -lx86 -lstdc++ -lsupc++ -lgcc -lm

UNIS_UTIL_DIR = $(ulibpath)/../demo/utilities
UNIS_UTIL_C_SRCS = $(wildcard $(UNIS_UTIL_DIR)/*.c)
UNIS_UTIL_CPP_SRCS = $(wildcard $(UNIS_UTIL_DIR)/*.cpp)
UNIS_UTIL_APPS = $(sort $(addprefix $(BIN_DIR)/,$(basename $(notdir $(UNIS_UTIL_C_SRCS) $(UNIS_UTIL_CPP_SRCS)))))

apps=\
	$(BIN_DIR)/_rust \

include subapps/Makefile.gui

$(BIN_DIR)/_rust: subapps/_hello/rust/src/main.rs subapps/_hello/rust/Cargo.toml
	@echo "MK hello-rust"
	@cd subapps/_hello/rust/ && cargo build --release --target ../../../configs/Rust/target/cargo-i686.json
	cp subapps/_hello/rust/target/cargo-i686/release/rust $@
