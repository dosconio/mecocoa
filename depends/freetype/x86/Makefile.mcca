# 用于 Mecocoa x86/x64 独立环境的 FreeType 编译配置文件
# 路径：depends/freetype/x86/Makefile.mcca

target_arch?=x86
uincpath?=../../../unisym/inc
uobjpath?=../../../_obj

ifeq ($(target_arch),x86)
CC = gcc
AR = ar
OBJCOPY = objcopy
MCCA_FLAGS = -D_MCCA=0x8632 -D_ARC_x86=5 -D_DEBUG
ARCH_FLAGS = -m32 -mno-red-zone -mno-sse -mno-sse2 -mno-sse3 -mno-ssse3 -mno-sse4
OBJECT_DIR = $(uobjpath)/freetype-x86
TARGET = libfreetype.a
RENAME_SECTIONS = 1
else ifeq ($(target_arch),x64)
X64_PREFIX ?= x86_64-linux-gnu-
CC = $(X64_PREFIX)gcc
AR = ar
OBJCOPY = objcopy
MCCA_FLAGS = -D_MCCA=0x8664 -D_UEFI -D_DEBUG
ARCH_FLAGS = -m64 -mno-red-zone -mno-sse -mno-sse2 -mno-avx -mno-avx2
OBJECT_DIR = $(uobjpath)/freetype-x64
TARGET = libfreetype-x64.a
RENAME_SECTIONS = 0
else ifeq ($(target_arch),ac7m)
AC7M_PREFIX ?= arm-none-eabi-
CC = $(AC7M_PREFIX)gcc
AR = $(AC7M_PREFIX)ar
OBJCOPY = $(AC7M_PREFIX)objcopy
MCCA_FLAGS = -D_MCCA=0x1A072032 -D_OPT_ARM32 -D_MCU_STM32H7x -D_HIS_IMPLEMENT -D_DEBUG
ARCH_FLAGS = -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -fshort-enums -fshort-wchar \
             -ffunction-sections -fdata-sections
OBJECT_DIR = $(uobjpath)/freetype-ac7m
TARGET = libfreetype-ac7m.a
RENAME_SECTIONS = 0
else ifeq ($(target_arch),ac7m-gcc)
AC7M_PREFIX ?= arm-none-eabi-
CC = $(AC7M_PREFIX)gcc
AR = $(AC7M_PREFIX)ar
OBJCOPY = $(AC7M_PREFIX)objcopy
MCCA_FLAGS = -D_MCCA=0x1A072032 -D_OPT_ARM32 -D_MCU_STM32H7x -D_HIS_IMPLEMENT -D_DEBUG
ARCH_FLAGS = -mcpu=cortex-m7 -mthumb -mfpu=fpv5-d16 -mfloat-abi=hard -fshort-enums \
             -ffunction-sections -fdata-sections
OBJECT_DIR = $(uobjpath)/freetype-ac7m-gcc
TARGET = libfreetype-ac7m-gcc.a
RENAME_SECTIONS = 0
else
$(error Unsupported target_arch '$(target_arch)'; expected x86, x64, ac7m or ac7m-gcc)
endif

# 桥接 setjmp/longjmp 宏定义，并配置 FreeType 特性
BRIDGE_FLAGS = -DFT2_BUILD_LIBRARY \
               $(MCCA_FLAGS)

# FreeType 本身头文件路径 + Unisym 独立库头文件路径
INCLUDES = -Iinclude \
           -I$(uincpath) \
           -I$(uincpath)/c/ISO_IEC_STD

# 独立环境 C 编译参数（禁用 SSE、红色区域、堆栈保护以及标准宿主库）
CFLAGS = $(ARCH_FLAGS) -static -fno-builtin -nostdlib -fno-stack-protector -O2 \
         -ffreestanding -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
         $(INCLUDES) $(BRIDGE_FLAGS)

# 根据 INSTALL.ANY 指南挑选的 FreeType 组件主文件
SRCS = src/base/ftsystem.c \
       src/base/ftinit.c \
       src/base/ftdebug.c \
       src/base/ftbase.c \
       src/base/ftbbox.c \
       src/base/ftglyph.c \
       src/base/ftbitmap.c \
       src/base/ftgasp.c \
       src/base/ftstroke.c \
       src/base/ftsynth.c \
       src/base/ftmm.c \
       src/sfnt/sfnt.c \
       src/truetype/truetype.c \
       src/smooth/smooth.c \
       src/raster/raster.c \
       src/autofit/autofit.c \
       src/gzip/ftgzip.c \
       src/psnames/psnames.c

OBJS = $(patsubst %.c, $(OBJECT_DIR)/%.o, $(SRCS))

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	@mkdir -p $(dir $@)
	@echo "AR $@"
	@$(AR) rcs $@ $^
	@if [ "$(RENAME_SECTIONS)" = "1" ]; then \
		$(OBJCOPY) --rename-section .text=.ext.freetype --rename-section .rodata=.ext.freetype --rename-section .data=.ext.freetype $@; \
	fi
	@echo "Cleaning up intermediate object files..."
	@rm -rf $(OBJECT_DIR)

$(OBJECT_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo "CC $<"
	@$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJECT_DIR)
	rm -f $(TARGET)
